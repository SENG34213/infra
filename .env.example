# ══════════════════════════════════════════════════
# Per-service database URLs, usernames, passwords
# ══════════════════════════════════════════════════

USER_DB_URL=user_db_url
USER_DB_USER=user_db_user
USER_DB_PASSWORD=user_db_password

BOOKING_DB_URL=booking_db_url
BOOKING_DB_USER=booking_db_user
BOOKING_DB_PASSWORD=booking_db_password

PAYMENT_DB_URL=payment_db_url
PAYMENT_DB_USER=payment_db_user
PAYMENT_DB_PASSWORD=payment_db_password

LOYALTY_DB_URL=loyalty_db_url
LOYALTY_DB_USER=loyalty_db_user
LOYALTY_DB_PASSWORD=loyalty_db_password

TOURNAMENT_DB_URL=jdbc:tournament_db_url
TOURNAMENT_DB_USER=tournament_db_user
TOURNAMENT_DB_PASSWORD=tournament_db_password

NOTIFICATION_DB_URL=notification_db_url
NOTIFICATION_DB_USER=notification_db_user
NOTIFICATION_DB_PASSWORD=notification_db_password

# ══════════════════════════════════════════════════
# Security — api-gateway and user-service
# ══════════════════════════════════════════════════
JWT_SECRET=replace-with-a-random-32-plus-character-string
GATEWAY_INTERNAL_SECRET=replace-with-a-random-secret

# ══════════════════════════════════════════════════
# Docker image tag
# ══════════════════════════════════════════════════
IMAGE_TAG=latest

# ══════════════════════════════════════════════════
# notification-service — Mail (optional)
# ══════════════════════════════════════════════════
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=replace-with-app-password
MAIL_FROM=your-email@example.com

# ══════════════════════════════════════════════════
# notification-service — Twilio SMS (optional)
# ══════════════════════════════════════════════════
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_DEFAULT_COUNTRY_CODE=+94