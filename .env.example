# Secret used to sign user-service JWTs; replace with a strong random value.
JWT_SECRET=replace-with-a-strong-random-jwt-secret
# Shared secret used to authenticate requests from the gateway.
GATEWAY_INTERNAL_SECRET=replace-with-a-strong-random-gateway-secret
# PostgreSQL username; defaults to gc_admin.
DB_USER=gc_admin
# PostgreSQL password; replace with a strong local-only password.
DB_PASSWORD=replace-with-a-strong-database-password
# Container image tag to use and publish.
IMAGE_TAG=latest